<UserControl x:Class="NoxyTools.Wpf.Views.FarmingSimulatorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:NoxyTools.Wpf.ViewModels"
             xmlns:ctrl="clr-namespace:NoxyTools.Wpf.Controls"
             xmlns:conv="clr-namespace:NoxyTools.Wpf.Converters"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:FarmingSimulatorViewModel, IsDesignTimeCreatable=False}">

    <UserControl.Resources>
        <conv:NullToVisibilityConverter  x:Key="NullToVisibilityConverter"/>
        <conv:BoolToVisibilityConverter  x:Key="BoolToVisibilityConverter"/>
        <conv:BoolToVisibilityConverter  x:Key="BoolToVisibilityInv" Invert="True"/>

        <!-- 3D 텍스트 효과 (NoxypediaSearchView와 동일) -->
        <Style x:Key="Label3dStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
            <Setter Property="FontSize"   Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect ShadowDepth="1.5" Direction="315"
                                      BlurRadius="0" Opacity="0.6" Color="Black"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 파밍 아이템 카드 스타일 -->
        <Style x:Key="FarmingCardStyle" TargetType="Border">
            <Setter Property="Background"      Value="{StaticResource ControlBackgroundBrush}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="4"/>
            <Setter Property="Margin"          Value="4,4,4,0"/>
            <Setter Property="Padding"         Value="6,6"/>
        </Style>

        <!-- 활성화 토글 버튼 스타일 -->
        <Style x:Key="ActiveToggleStyle" TargetType="Button" BasedOn="{StaticResource SpeedButtonStyle}">
            <Setter Property="Width"    Value="Auto"/>
            <Setter Property="Height"   Value="Auto"/>
            <Setter Property="MinHeight" Value="24"/>
            <Setter Property="Padding"  Value="6,3"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>

        <!-- 제거 버튼 스타일 -->
        <Style x:Key="RemoveButtonStyle" TargetType="Button" BasedOn="{StaticResource SpeedButtonStyle}">
            <Setter Property="Width"           Value="Auto"/>
            <Setter Property="Height"          Value="Auto"/>
            <Setter Property="MinHeight"       Value="24"/>
            <Setter Property="Padding"         Value="6,3"/>
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground"      Value="#EE4444"/>
            <Setter Property="FontSize"        Value="11"/>
        </Style>

        <!-- 투명 클릭 영역 버튼 스타일 -->
        <Style x:Key="TransparentClickStyle" TargetType="Button">
            <Setter Property="Background"           Value="Transparent"/>
            <Setter Property="BorderThickness"      Value="0"/>
            <Setter Property="Width"                Value="Auto"/>
            <Setter Property="Height"               Value="Auto"/>
            <Setter Property="HorizontalAlignment"  Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding"              Value="0"/>
            <Setter Property="Focusable"            Value="False"/>
            <Setter Property="Cursor"               Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#18FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#28FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 재료 행 DataTemplate -->
        <DataTemplate x:Key="MaterialRowTemplate" DataType="{x:Type vm:FarmingMaterialVM}">
            <Button HorizontalAlignment="Stretch"
                    Width="Auto" Height="Auto"
                    BorderThickness="0,0,0,1" Padding="6,5"
                    Command="{Binding DataContext.SelectMaterialCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                    CommandParameter="{Binding}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource SpeedButtonStyle}">
                        <Setter Property="Background" Value="{StaticResource ControlBackgroundBrush}"/>
                        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                        <Setter Property="Width"  Value="Auto"/>
                        <Setter Property="Height" Value="Auto"/>
                        <!-- ContentPresenter를 Stretch로 처리해 Grid가 Padding 영역을 제외한
                             올바른 폭을 자동으로 채우도록 ControlTemplate을 재정의합니다.
                             (SpeedButtonStyle의 기본 HorizontalAlignment="Center" 를 교체) -->
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="border"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="3"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Stretch"
                                                          VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="border" Property="Background"
                                                    Value="{StaticResource HoverBackgroundBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="border" Property="Background"
                                                    Value="{StaticResource AccentPressedBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Opacity" Value="0.35"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <!-- 강조: 선택된 파밍 항목의 레시피 재료 -->
                            <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                                <Setter Property="Background" Value="#1A4EC9B0"/>
                                <Setter Property="BorderBrush" Value="#4EC9B0"/>
                            </DataTrigger>
                            <!-- 선택됨 (IsSelected 우선) -->
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter Property="Background" Value="{StaticResource SelectionBackgroundBrush}"/>
                                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="36"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="60"/>
                    </Grid.ColumnDefinitions>

                    <!-- 재료 이미지 -->
                    <Border Grid.Column="0"
                            Width="30" Height="30"
                            Background="{StaticResource SurfaceBackgroundBrush}"
                            Margin="0,0,6,0">
                        <Image Source="{Binding Image}"
                               Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="NearestNeighbor"
                               Visibility="{Binding Image, Converter={StaticResource NullToVisibilityConverter}}"/>
                    </Border>

                    <!-- 재료 등급 + 이름 (+ 도박 재료명) -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding GradeName, StringFormat=[{0}]}"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   FontSize="10"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding MaterialName}"
                                       Foreground="{StaticResource PrimaryTextBrush}"
                                       FontSize="12" FontWeight="SemiBold"
                                       TextWrapping="Wrap"/>
                            <!-- 보조-도박 등급: 도박 재료 이름을 괄호로 표시 -->
                            <TextBlock Text="{Binding GambleMaterialName, StringFormat=({0})}"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       FontSize="11"
                                       VerticalAlignment="Center"
                                       Margin="4,0,0,0"
                                       Visibility="{Binding GambleMaterialName,
                                                    Converter={StaticResource NullToVisibilityConverter}}"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- 수량 -->
                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Margin="4,0">
                        <TextBlock Text="×"
                                   Foreground="{StaticResource AccentTextBrush}"
                                   FontSize="13" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding TotalCount}"
                                   Foreground="{StaticResource AccentTextBrush}"
                                   FontSize="13" FontWeight="SemiBold"/>
                    </StackPanel>
                </Grid>
            </Button>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Background="{StaticResource SurfaceBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" MinWidth="200" MaxWidth="500"/>
            <ColumnDefinition Width="4"/>
            <ColumnDefinition Width="*" MinWidth="400"/>
        </Grid.ColumnDefinitions>

        <!-- ══════════════════════════════════════════════════════════════ -->
        <!-- 좌: 아이템 검색 + 추가 버튼                                    -->
        <!-- ══════════════════════════════════════════════════════════════ -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ctrl:SearchItemControl Grid.Row="0" DataContext="{Binding SearchItemVM}"/>

            <!-- 추가 버튼 바 -->
            <Border Grid.Row="1"
                    Background="{StaticResource MenuBarBackgroundBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="6,5">
                <DockPanel>
                    <Button DockPanel.Dock="Right"
                            Content="+ 파밍에 추가"
                            Command="{Binding AddItemCommand}"
                            Style="{StaticResource SpeedButtonStyle}"
                            Width="Auto" Height="Auto"
                            Padding="10,5" FontSize="12"/>
                    <TextBlock Text="더블클릭 또는 버튼으로 추가"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               FontSize="11"
                               VerticalAlignment="Center"/>
                </DockPanel>
            </Border>
        </Grid>

        <!-- 세로 분리선 -->
        <GridSplitter Grid.Column="1"
                      Width="4"
                      HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                      Background="{StaticResource BorderBrush}"
                      Cursor="SizeWE" ShowsPreview="True"/>

        <!-- ══════════════════════════════════════════════════════════════ -->
        <!-- 우: 아이템 정보 (상단) + 파밍 리스트·재료·획득 정보 (하단)     -->
        <!-- ══════════════════════════════════════════════════════════════ -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="300" MinHeight="80" MaxHeight="420"/>
                <RowDefinition Height="4"/>
                <RowDefinition Height="*" MinHeight="160"/>
            </Grid.RowDefinitions>

            <!-- ── 우 상단: 선택된 아이템 정보 ─────────────────────────── -->
            <Border Grid.Row="0"
                    Background="{StaticResource PanelBackgroundBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,0"
                    Padding="8,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="56"/>   <!-- 이미지 -->
                        <ColumnDefinition Width="140"/>  <!-- 등급/이름 -->
                        <ColumnDefinition Width="1"/>    <!-- 구분선 -->
                        <ColumnDefinition Width="*"/>    <!-- 상세 스펙 -->
                    </Grid.ColumnDefinitions>

                    <!-- 아이템 이미지 -->
                    <Border Grid.Column="0"
                            Width="48" Height="48"
                            HorizontalAlignment="Left" VerticalAlignment="Top"
                            Background="{StaticResource ControlBackgroundBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1">
                        <Image Source="{Binding DetailVM.SelectedItemImage}"
                               Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                    </Border>

                    <!-- 부위 / 등급 / 이름 -->
                    <StackPanel Grid.Column="1"
                                VerticalAlignment="Top"
                                Margin="6,2,4,0">
                        <TextBlock Text="{Binding DetailVM.SelectedItemPart}"
                                   Style="{StaticResource Label3dStyle}"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   FontSize="10"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding DetailVM.SelectedItemGrade}"
                                   Style="{StaticResource Label3dStyle}"
                                   Foreground="{Binding DetailVM.GradeColor}"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding DetailVM.SelectedItemName}"
                                   Style="{StaticResource Label3dStyle}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                    <!-- 구분선 -->
                    <Rectangle Grid.Column="2"
                               Fill="{StaticResource BorderBrush}"
                               VerticalAlignment="Stretch"
                               Margin="0,2"/>

                    <!-- 상세 스펙 RichTextBox (코드비하인드에서 Document 동기화) -->
                    <RichTextBox Grid.Column="3"
                                 x:Name="InfoRichTextBox"
                                 IsReadOnly="True"
                                 Background="#1E1E1E"
                                 Foreground="#E0E0E0"
                                 FontFamily="맑은 고딕, Malgun Gothic"
                                 FontSize="12"
                                 Padding="8,0,0,0"
                                 BorderThickness="0"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Disabled">
                        <FlowDocument/>
                    </RichTextBox>
                </Grid>
            </Border>

            <!-- 수평 분리선 -->
            <GridSplitter Grid.Row="1"
                          Height="4"
                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          Background="{StaticResource BorderBrush}"
                          Cursor="SizeNS" ShowsPreview="True"/>

            <!-- ── 우 하단: [파밍 리스트 + 재료] | [획득 정보] ─────────── -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="200"/>
                    <ColumnDefinition Width="4"/>
                    <ColumnDefinition Width="240" MinWidth="160" MaxWidth="420"/>
                </Grid.ColumnDefinitions>

                <!-- ── 하단 좌: 파밍 아이템 리스트 + 재료 목록 ────────── -->
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" MinHeight="80"/>
                        <RowDefinition Height="4"/>
                        <RowDefinition Height="*" MinHeight="80"/>
                    </Grid.RowDefinitions>

                    <!-- ── 파밍 아이템 리스트 ──────────────────────────── -->
                    <Grid Grid.Row="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- 헤더 바 -->
                        <Border Grid.Row="0"
                                Background="{StaticResource MenuBarBackgroundBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="0,0,0,1"
                                Padding="8,5">
                            <DockPanel>
                                <Button DockPanel.Dock="Right"
                                        Content="전체 삭제"
                                        Command="{Binding ClearAllCommand}"
                                        Style="{StaticResource SpeedButtonStyle}"
                                        Width="Auto" Height="Auto"
                                        Padding="8,3" FontSize="11"/>
                                <TextBlock Text="파밍 아이템 리스트"
                                           Foreground="{StaticResource PrimaryTextBrush}"
                                           FontSize="12" FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>
                            </DockPanel>
                        </Border>

                        <!-- 빈 상태 안내 -->
                        <TextBlock Grid.Row="1"
                                   Text="아이템을 더블클릭하거나 '+ 파밍에 추가' 버튼으로&#x0a;파밍 리스트에 추가하세요."
                                   Foreground="{StaticResource DisabledTextBrush}"
                                   FontSize="12" TextAlignment="Center"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding FarmingListEmpty, Converter={StaticResource BoolToVisibilityConverter}}"/>

                        <!-- 파밍 카드 목록 -->
                        <ScrollViewer Grid.Row="1"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Visibility="{Binding FarmingListEmpty, Converter={StaticResource BoolToVisibilityInv}}">
                            <ItemsControl ItemsSource="{Binding FarmingList}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:FarmingEntry}">
                                        <Border>
                                            <Border.Style>
                                                <Style TargetType="Border" BasedOn="{StaticResource FarmingCardStyle}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                            <Setter Property="Opacity"     Value="0.45"/>
                                                            <Setter Property="BorderBrush" Value="{StaticResource DisabledTextBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                                            <Setter Property="Background"  Value="{StaticResource SelectionBackgroundBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <!-- 아이템 정보 행 -->
                                                <Grid Grid.Row="0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>    <!-- 클릭 가능 영역 -->
                                                        <ColumnDefinition Width="Auto"/> <!-- 활성화 토글 -->
                                                        <ColumnDefinition Width="Auto"/> <!-- 제거 버튼 -->
                                                    </Grid.ColumnDefinitions>

                                                    <!-- 클릭 영역: 이미지 + 이름/등급/부위 -->
                                                    <Button Grid.Column="0"
                                                            Style="{StaticResource TransparentClickStyle}"
                                                            Command="{Binding DataContext.SelectFarmingItemCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}">
                                                        <Grid Margin="0,0,4,0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="48"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>

                                                            <!-- 아이템 이미지 -->
                                                            <Border Grid.Column="0"
                                                                    Width="44" Height="44"
                                                                    Background="{StaticResource SurfaceBackgroundBrush}"
                                                                    BorderBrush="{StaticResource BorderBrush}"
                                                                    BorderThickness="1"
                                                                    Margin="0,0,8,0">
                                                                <Image Source="{Binding Image}"
                                                                       Stretch="Uniform"
                                                                       RenderOptions.BitmapScalingMode="NearestNeighbor"
                                                                       Visibility="{Binding Image, Converter={StaticResource NullToVisibilityConverter}}"/>
                                                            </Border>

                                                            <!-- 이름/등급/부위 -->
                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Text="{Binding PartName}"
                                                                               Foreground="{StaticResource SecondaryTextBrush}"
                                                                               FontSize="10"
                                                                               Margin="0,0,4,0"/>
                                                                    <TextBlock Text="{Binding GradeName, StringFormat=[{0}]}"
                                                                               Foreground="{StaticResource SecondaryTextBrush}"
                                                                               FontSize="10"/>
                                                                </StackPanel>
                                                                <TextBlock Text="{Binding ItemName}"
                                                                           Foreground="{StaticResource PrimaryTextBrush}"
                                                                           FontSize="12" FontWeight="SemiBold"
                                                                           TextWrapping="Wrap"/>
                                                                <!-- 이전 아이템 이름 괄호 표시 -->
                                                                <TextBlock Text="{Binding BeforeItemsLabel, StringFormat=({0})}"
                                                                           Foreground="{StaticResource SecondaryTextBrush}"
                                                                           FontSize="11"
                                                                           TextWrapping="Wrap"
                                                                           Visibility="{Binding BeforeItemsLabel, Converter={StaticResource NullToVisibilityConverter}}"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Button>

                                                    <!-- 활성화 토글 버튼 -->
                                                    <Button Grid.Column="1"
                                                            Command="{Binding ToggleActiveCommand}"
                                                            VerticalAlignment="Center"
                                                            Margin="0,0,2,0">
                                                        <Button.Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource ActiveToggleStyle}">
                                                                <Setter Property="Content"  Value="● 활성"/>
                                                                <Setter Property="Foreground" Value="#44BB44"/>
                                                                <Setter Property="ToolTip"  Value="비활성화 (재료 계산에서 제외)"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                                        <Setter Property="Content"    Value="○ 비활성"/>
                                                                        <Setter Property="Foreground" Value="{StaticResource DisabledTextBrush}"/>
                                                                        <Setter Property="ToolTip"    Value="활성화 (재료 계산에 포함)"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>

                                                    <!-- 제거 버튼 -->
                                                    <Button Grid.Column="2"
                                                            Content="✕ 삭제"
                                                            Command="{Binding RemoveCommand}"
                                                            Style="{StaticResource RemoveButtonStyle}"
                                                            VerticalAlignment="Center"
                                                            ToolTip="리스트에서 제거"/>
                                                </Grid>

                                                <!-- 티어 네비게이션 행 -->
                                                <Grid Grid.Row="1" HorizontalAlignment="Right" Margin="0,4,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- ◀ 이전 티어 -->
                                                    <Grid Grid.Column="0" Margin="0,0,2,0">
                                                        <Grid.Style>
                                                            <Style TargetType="Grid">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding PrevTierVisible}" Value="False">
                                                                        <Setter Property="Visibility" Value="Hidden"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Grid.Style>
                                                        <Button x:Name="BtnPrevTier"
                                                                Content="◀ 이전"
                                                                Command="{Binding NavigatePrevTierCommand}"
                                                                Style="{StaticResource SpeedButtonStyle}"
                                                                Width="Auto" Height="Auto"
                                                                MinWidth="46" Padding="6,3"
                                                                ToolTip="이전 티어로 변경"/>
                                                        <Popup IsOpen="{Binding IsNavPrevPopupOpen, Mode=TwoWay}"
                                                               PlacementTarget="{Binding ElementName=BtnPrevTier}"
                                                               Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                                                            <Border Background="{StaticResource ControlBackgroundBrush}"
                                                                    BorderBrush="{StaticResource AccentBrush}" BorderThickness="1"
                                                                    MinWidth="160" Padding="2">
                                                                <ItemsControl ItemsSource="{Binding NavPrevChoices}">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <Button Width="Auto" Height="Auto" HorizontalAlignment="Stretch"
                                                                                    HorizontalContentAlignment="Left" Padding="6,4" Margin="0,1"
                                                                                    Style="{StaticResource SpeedButtonStyle}"
                                                                                    Command="{Binding DataContext.NavigateTierChoiceCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                                    CommandParameter="{Binding}">
                                                                                <StackPanel Orientation="Horizontal">
                                                                                    <Border Width="20" Height="20" Margin="0,0,4,0"
                                                                                            Background="{StaticResource SurfaceBackgroundBrush}"
                                                                                            Visibility="{Binding Image, Converter={StaticResource NullToVisibilityConverter}}">
                                                                                        <Image Source="{Binding Image}" Stretch="Uniform"
                                                                                               RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                                                                    </Border>
                                                                                    <TextBlock Text="{Binding Text}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                                                                </StackPanel>
                                                                            </Button>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </Border>
                                                        </Popup>
                                                    </Grid>

                                                    <!-- ▶ 다음 티어 -->
                                                    <Grid Grid.Column="1">
                                                        <Grid.Style>
                                                            <Style TargetType="Grid">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding NextTierVisible}" Value="False">
                                                                        <Setter Property="Visibility" Value="Hidden"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Grid.Style>
                                                        <Button x:Name="BtnNextTier"
                                                                Content="다음 ▶"
                                                                Command="{Binding NavigateNextTierCommand}"
                                                                Style="{StaticResource SpeedButtonStyle}"
                                                                Width="Auto" Height="Auto"
                                                                MinWidth="46" Padding="6,3"
                                                                ToolTip="다음 티어로 변경"/>
                                                        <Popup IsOpen="{Binding IsNavNextPopupOpen, Mode=TwoWay}"
                                                               PlacementTarget="{Binding ElementName=BtnNextTier}"
                                                               Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                                                            <Border Background="{StaticResource ControlBackgroundBrush}"
                                                                    BorderBrush="{StaticResource AccentBrush}" BorderThickness="1"
                                                                    MinWidth="160" Padding="2">
                                                                <ItemsControl ItemsSource="{Binding NavNextChoices}">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <Button Width="Auto" Height="Auto" HorizontalAlignment="Stretch"
                                                                                    HorizontalContentAlignment="Left" Padding="6,4" Margin="0,1"
                                                                                    Style="{StaticResource SpeedButtonStyle}"
                                                                                    Command="{Binding DataContext.NavigateTierChoiceCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                                    CommandParameter="{Binding}">
                                                                                <StackPanel Orientation="Horizontal">
                                                                                    <Border Width="20" Height="20" Margin="0,0,4,0"
                                                                                            Background="{StaticResource SurfaceBackgroundBrush}"
                                                                                            Visibility="{Binding Image, Converter={StaticResource NullToVisibilityConverter}}">
                                                                                        <Image Source="{Binding Image}" Stretch="Uniform"
                                                                                               RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                                                                    </Border>
                                                                                    <TextBlock Text="{Binding Text}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                                                                </StackPanel>
                                                                            </Button>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </Border>
                                                        </Popup>
                                                    </Grid>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>

                    <!-- 수평 분리선 -->
                    <GridSplitter Grid.Row="1"
                                  Height="4"
                                  HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                  Background="{StaticResource BorderBrush}"
                                  Cursor="SizeNS" ShowsPreview="True"/>

                    <!-- ── 필요 재료 목록 ──────────────────────────────── -->
                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- 헤더 바 -->
                        <Border Grid.Row="0"
                                Background="{StaticResource MenuBarBackgroundBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="0,0,0,1"
                                Padding="8,5">
                            <TextBlock Text="필요 재료 목록"
                                       Foreground="{StaticResource PrimaryTextBrush}"
                                       FontSize="12" FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <!-- 빈 상태 안내 -->
                        <TextBlock Grid.Row="1"
                                   Text="조합법이 있는 아이템을 추가하면&#x0a;필요 재료가 여기에 표시됩니다."
                                   Foreground="{StaticResource DisabledTextBrush}"
                                   FontSize="12" TextAlignment="Center"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding MaterialsEmpty, Converter={StaticResource BoolToVisibilityConverter}}"/>

                        <!-- 재료 목록 -->
                        <ScrollViewer Grid.Row="1"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Visibility="{Binding MaterialsEmpty, Converter={StaticResource BoolToVisibilityInv}}">
                            <ItemsControl ItemsSource="{Binding MaterialsSummary}"
                                          ItemTemplate="{StaticResource MaterialRowTemplate}"/>
                        </ScrollViewer>
                    </Grid>
                </Grid>

                <!-- 세로 분리선 -->
                <GridSplitter Grid.Column="1"
                              Width="4"
                              HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                              Background="{StaticResource BorderBrush}"
                              Cursor="SizeWE" ShowsPreview="True"/>

                <!-- ── 하단 우: 획득 정보 ───────────────────────────────── -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>            <!-- 헤더 -->
                        <RowDefinition Height="240" MinHeight="80"/> <!-- 맵 이미지 -->
                        <RowDefinition Height="4"/>               <!-- 분리선 -->
                        <RowDefinition Height="*" MinHeight="60"/> <!-- 드롭 크리프 -->
                    </Grid.RowDefinitions>

                    <!-- 헤더 -->
                    <Border Grid.Row="0"
                            Background="{StaticResource MenuBarBackgroundBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="8,5">
                        <DockPanel>
                            <!-- 조합 장소 (있을 때만 우측 표시) -->
                            <StackPanel DockPanel.Dock="Right"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center"
                                        Visibility="{Binding DetailVM.CraftLocationEnabled, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="조합:"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           FontSize="11"
                                           VerticalAlignment="Center"
                                           Margin="0,0,4,0"/>
                                <TextBlock Text="{Binding DetailVM.CraftLocationName}"
                                           Foreground="{StaticResource AccentTextBrush}"
                                           FontSize="11" FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="획득 정보"
                                       Foreground="{StaticResource PrimaryTextBrush}"
                                       FontSize="12" FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>

                    <!-- 맵 이미지 -->
                    <Border Grid.Row="1"
                            Background="{StaticResource SurfaceBackgroundBrush}"
                            Margin="6,6,6,0">
                        <Grid>
                            <!-- 맵 없을 때 아이콘 -->
                            <TextBlock Text="🗺"
                                       FontSize="36"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Opacity" Value="0.3"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DetailVM.MapImage, Converter={StaticResource NullToVisibilityConverter}}" Value="Visible">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <!-- 맵 이미지 -->
                            <Image Source="{Binding DetailVM.MapImage}"
                                   Stretch="Uniform"
                                   Visibility="{Binding DetailVM.MapImage, Converter={StaticResource NullToVisibilityConverter}}"/>
                        </Grid>
                    </Border>

                    <!-- 분리선 -->
                    <GridSplitter Grid.Row="2"
                                  Height="4"
                                  HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                  Background="{StaticResource BorderBrush}"
                                  Cursor="SizeNS" ShowsPreview="True"/>

                    <!-- 획득 정보 없을 때 안내 -->
                    <TextBlock Grid.Row="3"
                               Text="아이템을 선택하면&#x0a;획득 정보가 표시됩니다."
                               Foreground="{StaticResource DisabledTextBrush}"
                               FontSize="12" TextAlignment="Center"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               TextWrapping="Wrap"
                               Visibility="{Binding DetailVM.DropCreepsPanelVisible, Converter={StaticResource BoolToVisibilityInv}}"/>

                    <!-- 드롭 크리프 RichTextBox (코드비하인드에서 Document 동기화) -->
                    <RichTextBox Grid.Row="3"
                                 x:Name="DropCreepsRichTextBox"
                                 IsReadOnly="True"
                                 Background="#1E1E1E"
                                 Foreground="#E0E0E0"
                                 FontFamily="맑은 고딕, Malgun Gothic"
                                 FontSize="12"
                                 Padding="8"
                                 BorderThickness="0"
                                 VerticalScrollBarVisibility="Auto"
                                 Margin="0,0,0,0"
                                 Visibility="{Binding DetailVM.DropCreepsPanelVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                        <FlowDocument/>
                    </RichTextBox>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
