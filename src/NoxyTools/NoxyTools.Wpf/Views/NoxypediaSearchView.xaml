<UserControl x:Class="NoxyTools.Wpf.Views.NoxypediaSearchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:NoxyTools.Wpf.ViewModels"
             xmlns:ctrl="clr-namespace:NoxyTools.Wpf.Controls"
             xmlns:conv="clr-namespace:NoxyTools.Wpf.Converters"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:NoxypediaSearchViewModel, IsDesignTimeCreatable=False}">

    <UserControl.Resources>
        <conv:NullToVisibilityConverter  x:Key="NullToVisibilityConverter"/>
        <conv:BoolToVisibilityConverter  x:Key="BoolToVisibilityConverter"/>
        <conv:BoolToVisibilityConverter  x:Key="InvertedBoolToVisibilityConverter" Invert="True"/>

        <!-- 3D 텍스트 효과 스타일 -->
        <Style x:Key="Label3dStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
            <Setter Property="FontSize"   Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect ShadowDepth="1.5" Direction="315"
                                      BlurRadius="0" Opacity="0.6"
                                      Color="Black"/>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 선택됨 강조 버튼 스타일 -->
        <Style x:Key="NavItemButtonStyle" TargetType="Button" BasedOn="{StaticResource SpeedButtonStyle}">
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="TextBlock.TextAlignment"    Value="Left"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="MinHeight" Value="26"/>
        </Style>
        <Style x:Key="NavItemButtonSelectedStyle" TargetType="Button" BasedOn="{StaticResource NavItemButtonStyle}">
            <Setter Property="Background" Value="{StaticResource AccentPressedBrush}"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource SurfaceBackgroundBrush}">
        <!-- 메인 영역: 좌(검색) | 우(버튼바 + 아이템 정보 + 탭) -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" MinWidth="200" MaxWidth="500"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 좌: 아이템 검색 (전체 높이) -->
            <ctrl:SearchItemControl Grid.Column="0"
                                    DataContext="{Binding SearchItemVM}"/>

            <GridSplitter Grid.Column="1"
                          Width="4"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="{StaticResource BorderBrush}"
                          Cursor="SizeWE"
                          ShowsPreview="True"/>

            <!-- 우: 버튼바 + 아이템 정보 + 탭 -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>                                  <!-- 버튼 바 -->
                    <RowDefinition Height="300" MinHeight="80" MaxHeight="420"/>    <!-- 아이템 정보 -->
                    <RowDefinition Height="4"/>                                     <!-- 수평 분리선 -->
                    <RowDefinition Height="*"/>                                     <!-- 탭 -->
                </Grid.RowDefinitions>

                <!-- ── 버튼 바: 이름 복사 / ◀ 이전 / 다음 ▶ / 상태 메시지 ── -->
                <Border Grid.Row="0"
                        Background="{StaticResource MenuBarBackgroundBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="6,3">
                    <DockPanel>
                        <!-- 상태 메시지 (우측) -->
                        <TextBlock DockPanel.Dock="Right"
                                   Text="{Binding StatusMessage}"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   FontSize="11"
                                   VerticalAlignment="Center"
                                   Margin="8,0,0,0"/>

                        <!-- 이름 복사 -->
                        <Button Content="이름 복사"
                                Command="{Binding CopyItemNameCommand}"
                                Style="{StaticResource SpeedButtonStyle}"
                                Width="Auto" Height="Auto"
                                Padding="8,3" Margin="0,0,8,0"/>

                        <!-- ◀ 이전 / 다음 ▶ -->
                        <Grid Margin="0,0,4,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding NavPreviousVisible}" Value="False">
                                                <Setter Property="Visibility" Value="Hidden"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Button x:Name="BtnNavPrev" Content="◀ 이전"
                                        Command="{Binding NavigatePreviousCommand}"
                                        Style="{StaticResource SpeedButtonStyle}"
                                        MinWidth="64" MinHeight="26" Padding="8,3"/>
                                <Popup IsOpen="{Binding IsNavPreviousPopupOpen, Mode=TwoWay}"
                                       PlacementTarget="{Binding ElementName=BtnNavPrev}"
                                       Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                                    <Border Background="{StaticResource ControlBackgroundBrush}"
                                            BorderBrush="{StaticResource AccentBrush}" BorderThickness="1"
                                            MinWidth="200" Padding="2">
                                        <ItemsControl ItemsSource="{Binding NavPreviousChoices}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Width="Auto" Height="Auto" HorizontalAlignment="Stretch"
                                                            HorizontalContentAlignment="Left" Padding="8,6" Margin="0,1"
                                                            Style="{StaticResource SpeedButtonStyle}"
                                                            Command="{Binding DataContext.NavigateChoiceCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Border Width="28" Height="28" Margin="0,0,8,0"
                                                                    Background="{StaticResource SurfaceBackgroundBrush}"
                                                                    Visibility="{Binding Image, Converter={StaticResource NullToVisibilityConverter}}">
                                                                <Image Source="{Binding Image}" Stretch="Uniform"
                                                                       RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                                            </Border>
                                                            <TextBlock Text="{Binding Text}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                                        </StackPanel>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Border>
                                </Popup>
                            </Grid>

                            <Grid Grid.Column="1">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding NavNextVisible}" Value="False">
                                                <Setter Property="Visibility" Value="Hidden"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Button x:Name="BtnNavNext" Content="다음 ▶"
                                        Command="{Binding NavigateNextCommand}"
                                        Style="{StaticResource SpeedButtonStyle}"
                                        MinWidth="64" MinHeight="26" Padding="8,3"/>
                                <Popup IsOpen="{Binding IsNavNextPopupOpen, Mode=TwoWay}"
                                       PlacementTarget="{Binding ElementName=BtnNavNext}"
                                       Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                                    <Border Background="{StaticResource ControlBackgroundBrush}"
                                            BorderBrush="{StaticResource AccentBrush}" BorderThickness="1"
                                            MinWidth="200" Padding="2">
                                        <ItemsControl ItemsSource="{Binding NavNextChoices}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Width="Auto" Height="Auto" HorizontalAlignment="Stretch"
                                                            HorizontalContentAlignment="Left" Padding="8,6" Margin="0,1"
                                                            Style="{StaticResource SpeedButtonStyle}"
                                                            Command="{Binding DataContext.NavigateChoiceCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Border Width="28" Height="28" Margin="0,0,8,0"
                                                                    Background="{StaticResource SurfaceBackgroundBrush}"
                                                                    Visibility="{Binding Image, Converter={StaticResource NullToVisibilityConverter}}">
                                                                <Image Source="{Binding Image}" Stretch="Uniform"
                                                                       RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                                            </Border>
                                                            <TextBlock Text="{Binding Text}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                                        </StackPanel>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Border>
                                </Popup>
                            </Grid>
                        </Grid>
                    </DockPanel>
                </Border>

                <!-- ── 아이템 정보 (항상 표시) ── -->
                <Border Grid.Row="1"
                        Background="{StaticResource PanelBackgroundBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0"
                        Padding="8,6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="56"/>   <!-- 이미지 -->
                            <ColumnDefinition Width="130"/>  <!-- 등급/이름 -->
                            <ColumnDefinition Width="1"/>    <!-- 구분선 -->
                            <ColumnDefinition Width="*"/>    <!-- 상세 스펙 -->
                        </Grid.ColumnDefinitions>

                        <!-- 아이템 이미지 -->
                        <Border Grid.Column="0"
                                Width="48" Height="48"
                                HorizontalAlignment="Left" VerticalAlignment="Top"
                                Background="{StaticResource ControlBackgroundBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1">
                            <Image Source="{Binding SelectedItemImage}"
                                   Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                        </Border>

                        <!-- 부위 / 등급 / 이름 -->
                        <StackPanel Grid.Column="1"
                                    VerticalAlignment="Top"
                                    Margin="6,2,4,0">
                            <TextBlock Text="{Binding SelectedItemPart}"
                                       Style="{StaticResource Label3dStyle}"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       FontSize="10"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding SelectedItemGrade}"
                                       Style="{StaticResource Label3dStyle}"
                                       Foreground="{Binding GradeColor}"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding SelectedItemName}"
                                       Style="{StaticResource Label3dStyle}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>

                        <!-- 구분선 -->
                        <Rectangle Grid.Column="2"
                                   Fill="{StaticResource BorderBrush}"
                                   VerticalAlignment="Stretch"
                                   Margin="0,2"/>

                        <!-- 상세 스펙 RichTextBox -->
                        <RichTextBox Grid.Column="3"
                                     x:Name="InfoRichTextBox"
                                     IsReadOnly="True"
                                     Background="#1E1E1E"
                                     Foreground="#E0E0E0"
                                     FontFamily="맑은 고딕, Malgun Gothic"
                                     FontSize="12"
                                     Padding="8,0,0,0"
                                     BorderThickness="0"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Disabled">
                            <FlowDocument/>
                        </RichTextBox>
                    </Grid>
                </Border>

                <!-- 수평 분리선 (아이템 정보 높이 드래그 조절) -->
                <GridSplitter Grid.Row="2"
                              Height="4"
                              HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                              Background="{StaticResource BorderBrush}"
                              Cursor="SizeNS" ShowsPreview="True"/>

                <!-- ── 탭: 획득 정보 / 테크 ── -->
                <TabControl Grid.Row="3"
                            SelectedIndex="{Binding SelectedTabIndex}"
                            Background="{StaticResource PanelBackgroundBrush}"
                            BorderBrush="{StaticResource BorderBrush}">

                    <!-- ══ 탭 1: 획득 정보 ══════════════════════════ -->
                    <TabItem Header="획득정보">
                        <Grid Background="{StaticResource PanelBackgroundBrush}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- 상단: 레시피 + 재료 버튼 -->
                            <Border Grid.Row="0"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="0,0,0,1"
                                    Padding="8,6">
                                <StackPanel>
                                    <!-- 레시피 텍스트 + 복사 -->
                                    <DockPanel Margin="0,0,0,6">
                                        <Button DockPanel.Dock="Right"
                                                Content="복사"
                                                Width="44"
                                                Margin="4,0,0,0"
                                                Command="{Binding CopyCraftRecipeCommand}"
                                                Style="{StaticResource SpeedButtonStyle}"/>
                                        <TextBox Text="{Binding CraftRecipeText, Mode=OneWay}"
                                                 IsReadOnly="True"
                                                 Background="{StaticResource InputBackgroundBrush}"
                                                 Foreground="{StaticResource PrimaryTextBrush}"
                                                 BorderBrush="{StaticResource BorderBrush}"
                                                 FontFamily="맑은 고딕, Malgun Gothic"
                                                 FontSize="11"
                                                 Padding="4,3"/>
                                    </DockPanel>

                                    <!-- 재료 버튼 -->
                                    <TextBlock Text="재료" Style="{StaticResource CaptionTextStyle}" Margin="0,0,0,4"/>
                                    <ItemsControl ItemsSource="{Binding CraftMaterials}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <ContentControl Content="{Binding}">
                                                    <ContentControl.Resources>
                                                        <!-- 구분자 레이블 템플릿 -->
                                                        <DataTemplate x:Key="SeparatorTemplate">
                                                            <Border BorderBrush="#FFCC44" BorderThickness="2,0,0,0"
                                                                    Margin="6,2,6,4" Padding="5,3"
                                                                    VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Text}"
                                                                           Foreground="#FFCC44"
                                                                           FontSize="11"
                                                                           FontWeight="SemiBold"
                                                                           VerticalAlignment="Center"/>
                                                            </Border>
                                                        </DataTemplate>
                                                        <!-- 일반/대체 재료 버튼 템플릿 -->
                                                        <DataTemplate x:Key="ButtonTemplate">
                                                            <Button Margin="0,0,4,4"
                                                                    Padding="8,5"
                                                                    MinHeight="42"
                                                                    Width="Auto" Height="Auto"
                                                                    Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    Command="{Binding DataContext.SelectMaterialButtonCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    CommandParameter="{Binding}">
                                                                <Button.ContextMenu>
                                                                    <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                                                                        <MenuItem Header="아이템 찾기"
                                                                                  Command="{Binding SelectMaterialButtonCommand}"
                                                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                                    </ContextMenu>
                                                                </Button.ContextMenu>
                                                                <Button.Style>
                                                                    <Style TargetType="Button" BasedOn="{StaticResource SpeedButtonStyle}">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                                <Setter Property="Background" Value="{StaticResource AccentPressedBrush}"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding IsSubstitute}" Value="True">
                                                                                <Setter Property="BorderBrush" Value="#FFCC44"/>
                                                                                <Setter Property="BorderThickness" Value="1.5"/>
                                                                            </DataTrigger>
                                                                            <MultiDataTrigger>
                                                                                <MultiDataTrigger.Conditions>
                                                                                    <Condition Binding="{Binding IsSubstitute}" Value="True"/>
                                                                                    <Condition Binding="{Binding IsSelected}" Value="True"/>
                                                                                </MultiDataTrigger.Conditions>
                                                                                <Setter Property="Background" Value="{StaticResource AccentPressedBrush}"/>
                                                                                <Setter Property="BorderBrush" Value="#FFCC44"/>
                                                                                <Setter Property="BorderThickness" Value="2"/>
                                                                            </MultiDataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Button.Style>
                                                                <StackPanel Orientation="Horizontal">
                                                                    <Image Source="{Binding Image}"
                                                                           Width="36" Height="36"
                                                                           Margin="0,0,6,0"
                                                                           RenderOptions.BitmapScalingMode="NearestNeighbor"
                                                                           Visibility="{Binding Image, Converter={StaticResource NullToVisibilityConverter}}"/>
                                                                    <TextBlock Text="{Binding Text}" VerticalAlignment="Center"/>
                                                                </StackPanel>
                                                            </Button>
                                                        </DataTemplate>
                                                    </ContentControl.Resources>
                                                    <ContentControl.Style>
                                                        <Style TargetType="ContentControl">
                                                            <Setter Property="ContentTemplate" Value="{StaticResource ButtonTemplate}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSeparator}" Value="True">
                                                                    <Setter Property="ContentTemplate" Value="{StaticResource SeparatorTemplate}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </ContentControl.Style>
                                                </ContentControl>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- 조합 장소 버튼 -->
                                    <Button Content="{Binding CraftLocationName}"
                                            Command="{Binding SelectCraftLocationButtonCommand}"
                                            IsEnabled="{Binding CraftLocationEnabled}"
                                            Width="Auto" Height="Auto"
                                            HorizontalAlignment="Left"
                                            Padding="10,5"
                                            MinHeight="28"
                                            Margin="0,6,0,0">
                                        <Button.ContextMenu>
                                            <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                <MenuItem Header="아이템 찾기"
                                                          Command="{Binding SelectCraftLocationButtonCommand}"/>
                                            </ContextMenu>
                                        </Button.ContextMenu>
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource SpeedButtonStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CraftLocationSelected}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource AccentPressedBrush}"/>
                                                        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <!-- 하단: 맵 이미지 + 지역 버튼 + 드롭 크리프 -->
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="300"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- 맵 이미지 -->
                                <Border Grid.Column="0"
                                        Background="{StaticResource SurfaceBackgroundBrush}"
                                        Margin="8">
                                    <Grid>
                                        <!-- 기본 아이콘 (맵 없을 때, 깜빡임 애니메이션) -->
                                        <TextBlock Text="🗺"
                                                   FontSize="48"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Opacity" Value="0.35"/>
                                                    <Style.Triggers>
                                                        <!-- 맵 이미지가 있으면 숨김 -->
                                                        <DataTrigger Binding="{Binding MapImage, Converter={StaticResource NullToVisibilityConverter}}" Value="Visible">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                        <!-- 맵 이미지 없을 때 깜빡임 -->
                                                        <DataTrigger Binding="{Binding MapImage}" Value="{x:Null}">
                                                            <DataTrigger.EnterActions>
                                                                <BeginStoryboard x:Name="MapBlinkStoryboard">
                                                                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                                         From="0.35" To="0.08"
                                                                                         Duration="0:0:0.5"/>
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </DataTrigger.EnterActions>
                                                            <DataTrigger.ExitActions>
                                                                <StopStoryboard BeginStoryboardName="MapBlinkStoryboard"/>
                                                            </DataTrigger.ExitActions>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <Image Source="{Binding MapImage}"
                                               Stretch="Uniform"
                                               Visibility="{Binding MapImage, Converter={StaticResource NullToVisibilityConverter}}"/>
                                    </Grid>
                                </Border>

                                <!-- 지역 버튼 + 드롭 크리프 -->
                                <Grid Grid.Column="1"
                                      Visibility="{Binding DropCreepsPanelVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <!-- 지역 버튼 -->
                                    <StackPanel Grid.Row="0" Margin="0,8,8,4">
                                        <TextBlock Text="지역" Style="{StaticResource CaptionTextStyle}" Margin="0,0,0,4"/>
                                        <ItemsControl ItemsSource="{Binding CraftRegions}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Margin="0,0,4,4"
                                                            Padding="8,4"
                                                            MinHeight="28"
                                                            Width="Auto" Height="Auto"
                                                            Content="{Binding Text}"
                                                            Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            Command="{Binding DataContext.SelectRegionButtonCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}">
                                                        <Button.ContextMenu>
                                                            <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                                                                <MenuItem Header="아이템 찾기"
                                                                          Command="{Binding SelectRegionButtonCommand}"
                                                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                            </ContextMenu>
                                                        </Button.ContextMenu>
                                                        <Button.Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource SpeedButtonStyle}">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                        <Setter Property="Background" Value="{StaticResource AccentPressedBrush}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                    <!-- 드롭 크리프 RichTextBox -->
                                    <RichTextBox Grid.Row="1"
                                                 x:Name="DropCreepsRichTextBox"
                                                 IsReadOnly="True"
                                                 Background="#1E1E1E"
                                                 Foreground="#E0E0E0"
                                                 FontFamily="맑은 고딕, Malgun Gothic"
                                                 FontSize="12"
                                                 Padding="8"
                                                 BorderThickness="0"
                                                 VerticalScrollBarVisibility="Auto"
                                                 Margin="0,0,8,8">
                                        <FlowDocument/>
                                    </RichTextBox>
                                </Grid>
                            </Grid>
                        </Grid>
                    </TabItem>

                    <!-- ══ 탭 3: 테크정보 ════════════════════════════════ -->
                    <TabItem Header="테크정보">
                        <Grid Background="{StaticResource PanelBackgroundBrush}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="4"/>
                                <ColumnDefinition Width="180"/>
                            </Grid.ColumnDefinitions>

                            <!-- 좌: 시작/최종 버튼 + 테크정보 RichTextBox -->
                            <Grid Grid.Column="0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- 시작 아이템 -->
                                <Border Grid.Row="0"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="0,0,0,1"
                                        Padding="8,6">
                                    <StackPanel>
                                        <TextBlock Text="시작 아이템" Style="{StaticResource CaptionTextStyle}" Margin="0,0,0,4"/>
                                        <ItemsControl ItemsSource="{Binding TechBeginItems}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Margin="0,0,4,4" Padding="6,4" MinHeight="32"
                                                            Width="Auto" Height="Auto"
                                                            Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            Command="{Binding DataContext.SelectTechBeginItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}">
                                                        <Button.ContextMenu>
                                                            <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                                                                <MenuItem Header="아이템 찾기"
                                                                          Command="{Binding SelectTechBeginItemCommand}"
                                                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                            </ContextMenu>
                                                        </Button.ContextMenu>
                                                        <Button.Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource SpeedButtonStyle}">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                        <Setter Property="Background" Value="{StaticResource AccentPressedBrush}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                        <StackPanel Orientation="Horizontal">
                                                            <Image Source="{Binding Image}" Width="24" Height="24" Margin="0,0,6,0"
                                                                   RenderOptions.BitmapScalingMode="NearestNeighbor"
                                                                   Visibility="{Binding Image, Converter={StaticResource NullToVisibilityConverter}}"/>
                                                            <TextBlock Text="{Binding Text}" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <!-- 최종 아이템 -->
                                <Border Grid.Row="1"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="0,0,0,1"
                                        Padding="8,6">
                                    <StackPanel>
                                        <TextBlock Text="최종 아이템" Style="{StaticResource CaptionTextStyle}" Margin="0,0,0,4"/>
                                        <ItemsControl ItemsSource="{Binding TechFinalItems}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Margin="0,0,4,4" Padding="6,4" MinHeight="32"
                                                            Width="Auto" Height="Auto"
                                                            Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            Command="{Binding DataContext.SelectTechFinalItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}">
                                                        <Button.ContextMenu>
                                                            <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                                                                <MenuItem Header="아이템 찾기"
                                                                          Command="{Binding SelectTechFinalItemCommand}"
                                                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                            </ContextMenu>
                                                        </Button.ContextMenu>
                                                        <Button.Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource SpeedButtonStyle}">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                        <Setter Property="Background" Value="{StaticResource AccentPressedBrush}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                        <StackPanel Orientation="Horizontal">
                                                            <Image Source="{Binding Image}" Width="24" Height="24" Margin="0,0,6,0"
                                                                   RenderOptions.BitmapScalingMode="NearestNeighbor"
                                                                   Visibility="{Binding Image, Converter={StaticResource NullToVisibilityConverter}}"/>
                                                            <TextBlock Text="{Binding Text}" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <!-- 테크 RichTextBox -->
                                <RichTextBox Grid.Row="2"
                                             x:Name="TechRichTextBox"
                                             IsReadOnly="True"
                                             Background="#1E1E1E"
                                             Foreground="#E0E0E0"
                                             FontFamily="맑은 고딕, Malgun Gothic"
                                             FontSize="12"
                                             Padding="8"
                                             BorderThickness="0"
                                             VerticalScrollBarVisibility="Auto">
                                    <FlowDocument/>
                                </RichTextBox>

                                <!-- 하단 옵션 + 복사 -->
                                <Border Grid.Row="3"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="0,1,0,0"
                                        Padding="8,6">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right"
                                                Content="복사"
                                                Width="50"
                                                Command="{Binding CopyTechCommand}"
                                                Style="{StaticResource SpeedButtonStyle}"/>
                                        <CheckBox Content="상세 표시"
                                                  IsChecked="{Binding TechDetailOption}"
                                                  VerticalAlignment="Center"/>
                                    </DockPanel>
                                </Border>
                            </Grid>

                            <GridSplitter Grid.Column="1" Width="4"
                                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                          Background="{StaticResource BorderBrush}" Cursor="SizeWE"/>

                            <!-- 우: 등급 색상 범례 -->
                            <RichTextBox Grid.Column="2"
                                         x:Name="TechGradeRichTextBox"
                                         IsReadOnly="True"
                                         Background="#1E1E1E"
                                         Foreground="#E0E0E0"
                                         FontFamily="맑은 고딕, Malgun Gothic"
                                         FontSize="12"
                                         Padding="8"
                                         BorderThickness="0,0,0,0"
                                         BorderBrush="{StaticResource BorderBrush}"
                                         VerticalScrollBarVisibility="Auto">
                                <FlowDocument/>
                            </RichTextBox>
                        </Grid>
                    </TabItem>

                </TabControl>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
